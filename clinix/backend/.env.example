# ============================================================================
# CliniX FastAPI backend — server configuration.
#
# Copy to .env (NEVER commit the real .env):  cp .env.example .env
# Backend secrets live ONLY here — never in the Flutter app.
# ============================================================================

APP_ENV=development
DEBUG=true

# ---------------------------------------------------------------------------
# Firebase Admin SDK (verify Flutter Firebase ID tokens + Firestore access).
# Get these from Firebase Console → Project settings → Service accounts.
# Keep the private key on ONE line with \n escapes.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# External services (server-side only).
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENFDA_API_KEY=            # optional — openFDA works without a key (rate limits apply)

# Timeouts (seconds)
AI_TIMEOUT=60
EXTERNAL_API_TIMEOUT=15

# ---------------------------------------------------------------------------
# Development mode: with MOCK_EXTERNAL_SERVICES=true the backend runs fully
# offline — external calls are replaced by clearly-labelled fixtures and an
# in-memory store, and dev bearer tokens ("dev-user", "dev-admin") authenticate.
# NEVER true in production.
# ---------------------------------------------------------------------------
MOCK_EXTERNAL_SERVICES=true

# Security / CORS (comma-separated explicit origins — no "*" in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

MAX_UPLOAD_SIZE_MB=8
RATE_LIMIT_PER_MINUTE=30

# Emergency guidance is configurable — do NOT hardcode numbers in code.
EMERGENCY_GUIDANCE_TEXT=If this is an emergency, contact your local emergency number immediately.
