# Copy to .env before building the release APK; public config only
# NEVER place secret API keys or backend credentials in this file.

# Render.com backend URL
API_BASE_URL=https://REPLACE-WITH-YOUR-RENDER-URL.onrender.com

# Set to false to connect to the live FastAPI backend
USE_MOCK_DATA=false

# Set to true to enable Firebase Authentication & Cloud Messaging
USE_FIREBASE=true

# API Network Timeout Settings (in milliseconds)
API_CONNECT_TIMEOUT_MS=15000
API_RECEIVE_TIMEOUT_MS=20000
