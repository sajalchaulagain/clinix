# ============================================================================
# CliniX public environment configuration.
#
# Copy this file to ".env" before running:  cp .env.example .env
#
# This file is bundled with the app (declared as a Flutter asset), so it is
# part of the shipped binary. ONLY put PUBLIC, non-sensitive configuration
# here. NEVER put API keys, OpenRouter keys, FastAPI secrets, or Firebase
# Admin credentials in this file or anywhere in the Flutter codebase.
# All sensitive operations are performed by the FastAPI backend.
# ============================================================================

# Base URL of the future FastAPI backend. Used only when USE_MOCK_DATA=false.
# BACKEND INTEGRATION: final value is confirmed when the backend is deployed.
API_BASE_URL=http://localhost:8000

# When true, repositories return clearly-labelled mock data for UI development.
# Set to false once the FastAPI backend contract is finalized.
USE_MOCK_DATA=true

# When true, Firebase-backed services are used (requires firebase_options.dart
# generated via `flutterfire configure`). App guards initialization in a
# try/catch so it still runs while Firebase is not configured yet.
USE_FIREBASE=false

# Network timeouts (milliseconds)
API_CONNECT_TIMEOUT_MS=15000
API_RECEIVE_TIMEOUT_MS=20000
